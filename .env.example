# Copy this file to .env and fill in your Supabase project values
# (Project Settings -> API in the Supabase dashboard).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog Project Settings -> Project API Key, and the host matching the
# region picked at signup (EU or US). Analytics silently no-ops if these
# are left unset — see lib/analytics.ts.
EXPO_PUBLIC_POSTHOG_KEY=phc_your-project-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
